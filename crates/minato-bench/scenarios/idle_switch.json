{
  "name": "idle_switch (3.5s between actions, overlay hidden)",
  "workspaces": [7, 8],
  "steps": [
    { "op": "workspace", "index": 7 },
    { "op": "open", "count": 4 },
    { "op": "workspace", "index": 8 },
    { "op": "open", "count": 4 },
    { "op": "sleep", "ms": 2500 },
    { "op": "cycle", "label": "switch_after_idle", "repeat": 6, "interval_ms": 3500, "workspaces": [7, 8] },
    { "op": "cycle", "label": "hotkey_switch_after_idle", "repeat": 6, "interval_ms": 3500, "warm_up_ms": 80, "workspaces": [7, 8] },
    { "op": "cycle", "label": "layout_after_idle", "repeat": 4, "interval_ms": 3500,
      "actions": [ { "type": "cycle_layout", "dir": "next" } ] },
    { "op": "cycle", "label": "hotkey_layout_after_idle", "repeat": 4, "interval_ms": 3500, "warm_up_ms": 80,
      "actions": [ { "type": "cycle_layout", "dir": "next" } ] }
  ]
}
